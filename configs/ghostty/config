# Ghostty config — managed by home-manager (modules/apps/ghostty.nix).
# Edit here, then `git commit` + `re`. Reload in Ghostty with cmd+shift+,
#
# Full option reference:
#   /Applications/Ghostty.app/Contents/MacOS/ghostty +show-config --default --docs
# Preview themes:
#   /Applications/Ghostty.app/Contents/MacOS/ghostty +list-themes

theme = Gruvbox Material Dark
working-directory = ~/Documents/dev

# --- macOS integration ---
# Left Option sends Alt/Meta (word-nav in zsh, alt-chords in Helix);
# right Option still types accented chars (option+e e -> é).
macos-option-as-alt = left

# --- Quality of life ---
# NOTE: Ghostty has no inline comments — `#` is only valid on its own line.
# A trailing `# ...` becomes part of the value, so keep comments above keys.
# selecting text auto-copies (tmux-like)
copy-on-select = clipboard
# cursor gets out of the way while typing
mouse-hide-while-typing = true
# restore windows/tabs after quit/relaunch
window-save-state = always
# no "are you sure?" prompt on cmd+w
confirm-close-surface = false

# --- Look ---
# Disable ligatures: -liga kills classic ligatures, -calt kills the
# contextual operator glyphs (=> != >= ->) most coding fonts ship.
font-feature = -liga, -calt

# (uncomment to taste — keep any explanatory comment on its own line)
