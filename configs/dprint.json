{
  "lineWidth": 100,
  "indentWidth": 2,
  "nix": {},
  "typescript": {},
  "json": {},
  "markdown": {},
  "toml": {},
  "exec": {
    "commands": [
      {
        "command": "clang-format -style=file:$HOME/.config/clang-format",
        "exts": ["c", "h", "cpp", "hpp"]
      },
      {
        "command": "shfmt -i 2 -ci -sr",
        "exts": ["sh"]
      },
      {
        "command": "rustfmt",
        "exts": ["rs"]
      },
      {
        "command": "swift format",
        "exts": ["swift"]
      }
    ]
  },
  "includes": ["**/*.{nix,ts,tsx,js,jsx,json,md,toml,py,c,h,cpp,hpp,sh,rs,swift}"],
  "excludes": ["**/node_modules", "**/result", "**/target"],
  "plugins": [
    "file:///Users/darrenlu/Documents/dev/dprint-plugin-nix/target/wasm32-unknown-unknown/release/dprint_plugin_nix.wasm",
    "https://plugins.dprint.dev/typescript-0.95.15.wasm",
    "https://plugins.dprint.dev/json-0.21.1.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/ruff-0.7.5.wasm",
    "https://github.com/dprint/dprint-plugin-exec/releases/download/0.6.0/plugin.json"
  ]
}
